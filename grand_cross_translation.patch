index 0000000..38bc7fa
--- /dev/null
+++ b/stream_translate.rs
@@ -0,0 +1,254 @@
+//! Chunked streaming translation — audio in, audio out, tuned to the
+//! measured floor (~300-500ms) instead of request-response.
+//!
+//! This does NOT wait for a full utterance. It accumulates PCM into
+//! `chunk_ms`-sized windows (StreamSpeech-style chunked encoding) and
+//! flushes each chunk to the backend as soon as it's full, so output
+//! starts streaming back before the player has finished talking.
+//!
+//! Backend contract lives in `StreamingTranslationBackend` — wire it
+//! to a chunked encoder (e.g. a StreamSpeech deployment) or a vendor
+//! streaming S2ST endpoint. No backend is bundled; see translate.rs
+//! for the same caveat on the request-response side.
+//!
+//! Use this for freeform voice. Use callout.rs for anything where a
+//! wrong or late translation has in-raid consequences — this module
+//! cannot go below the ~300ms information floor explained in-chat;
+//! that floor is physical (a chunk must contain enough audio to
+//! disambiguate meaning), not an engineering gap.
+
+use async_trait::async_trait;
+use dashmap::DashMap;
+use std::sync::Arc;
+
+use crate::translate::TranslateError;
+
+pub const SAMPLE_RATE_HZ: u32 = 48_000;
+
+/// Tunable chunk size. 350ms is a reasonable default balance point.
+/// Push lower for latency, higher for accuracy — below ~250ms,
+/// accuracy degrades sharply for most language pairs (verb-final
+/// languages like German/Japanese need more lookahead). Exposed
+/// per-instance rather than hardcoded so it can be tuned per
+/// language pair or per deployment.
+#[derive(Debug, Clone, Copy)]
+pub struct ChunkConfig {
+    pub chunk_ms: u32,
+}
+
+impl Default for ChunkConfig {
+    fn default() -> Self { Self { chunk_ms: 350 } }
+}
+
+impl ChunkConfig {
+    pub fn samples_per_chunk(&self) -> usize {
+        (SAMPLE_RATE_HZ as u64 * self.chunk_ms as u64 / 1000) as usize
+    }
+}
+
+/// Already-translated, already-synthesized PCM, ready to re-encode
+/// to Opus and forward through the existing VoiceFrame pipeline.
+#[derive(Debug, Clone)]
+pub struct TranslatedChunk {
+    pub player_id:   String,
+    pub target_lang: String,
+    pub pcm:         Vec<f32>,
+    pub seq:         u32,
+    /// True on the flush() call that drains a partial trailing buffer
+    /// (e.g. when VAD goes inactive) — signals downstream not to
+    /// expect more chunks for this utterance.
+    pub is_final:    bool,
+}
+
+/// Streaming backend contract: one chunk in, one chunk out. Must NOT
+/// buffer internally waiting for a full utterance — that defeats the
+/// point of chunking here. Implement against a real chunked S2ST
+/// model/endpoint.
+#[async_trait]
+pub trait StreamingTranslationBackend: Send + Sync {
+    async fn translate_chunk(
+        &self,
+        pcm_chunk: &[f32],
+        from: &str,
+        to: &str,
+    ) -> Result<Vec<f32>, TranslateError>;
+}
+
+/// Per (player, target_lang) rolling buffer.
+struct ChunkBuffer {
+    samples: Vec<f32>,
+    seq:     u32,
+}
+
+impl ChunkBuffer {
+    fn new() -> Self { Self { samples: Vec::new(), seq: 0 } }
+}
+
+/// Orchestrates chunked streaming translation across all active
+/// (player, target_lang) sessions. Same per-key state pattern as
+/// VoiceFilter in pipeline.rs — one buffer per session, not global.
+pub struct StreamTranslator<B: StreamingTranslationBackend> {
+    backend: Arc<B>,
+    config:  ChunkConfig,
+    buffers: DashMap<(String, String), ChunkBuffer>, // (player_id, target_lang)
+}
+
+impl<B: StreamingTranslationBackend> StreamTranslator<B> {
+    pub fn new(backend: B, config: ChunkConfig) -> Self {
+        Self {
+            backend: Arc::new(backend),
+            config,
+            buffers: DashMap::new(),
+        }
+    }
+
+    /// Feed incoming PCM for a player, targeted at one recipient
+    /// language. Returns a translated chunk once enough audio has
+    /// accumulated to flush; None if still buffering.
+    ///
+    /// Call once per (player, target_lang) pair per incoming voice
+    /// frame — fan out per recipient language, same as
+    /// translate_for_recipients does for text in translate.rs.
+    pub async fn ingest(
+        &self,
+        player_id:   &str,
+        from_lang:   &str,
+        target_lang: &str,
+        pcm:         &[f32],
+    ) -> Result<Option<TranslatedChunk>, TranslateError> {
+        let key = (player_id.to_string(), target_lang.to_string());
+        let threshold = self.config.samples_per_chunk();
+
+        let ready = {
+            let mut entry = self.buffers.entry(key.clone()).or_insert_with(ChunkBuffer::new);
+            entry.samples.extend_from_slice(pcm);
+            entry.samples.len() >= threshold
+        };
+
+        if !ready {
+            return Ok(None);
+        }
+
+        let (chunk, seq) = {
+            let mut entry = self.buffers.get_mut(&key).expect("key just inserted above");
+            let take = threshold.min(entry.samples.len());
+            let chunk: Vec<f32> = entry.samples.drain(..take).collect();
+            entry.seq += 1;
+            (chunk, entry.seq)
+        };
+
+        let translated = self.backend.translate_chunk(&chunk, from_lang, target_lang).await?;
+
+        Ok(Some(TranslatedChunk {
+            player_id:   player_id.to_string(),
+            target_lang: target_lang.to_string(),
+            pcm:         translated,
+            seq,
+            is_final:    false,
+        }))
+    }
+
+    /// Drain any partial trailing buffer — call when VAD goes
+    /// inactive (player stopped talking) so the last sub-chunk isn't
+    /// silently dropped. Result is marked is_final.
+    pub async fn flush(
+        &self,
+        player_id:   &str,
+        from_lang:   &str,
+        target_lang: &str,
+    ) -> Result<Option<TranslatedChunk>, TranslateError> {
+        let key = (player_id.to_string(), target_lang.to_string());
+
+        let (chunk, seq) = {
+            let Some(mut entry) = self.buffers.get_mut(&key) else { return Ok(None) };
+            if entry.samples.is_empty() { return Ok(None); }
+            let chunk: Vec<f32> = entry.samples.drain(..).collect();
+            entry.seq += 1;
+            (chunk, entry.seq)
+        };
+
+        let translated = self.backend.translate_chunk(&chunk, from_lang, target_lang).await?;
+
+        Ok(Some(TranslatedChunk {
+            player_id:   player_id.to_string(),
+            target_lang: target_lang.to_string(),
+            pcm:         translated,
+            seq,
+            is_final:    true,
+        }))
+    }
+
+    /// Drop a session's buffer entirely, e.g. on player disconnect.
+    pub fn drop_session(&self, player_id: &str, target_lang: &str) {
+        self.buffers.remove(&(player_id.to_string(), target_lang.to_string()));
+    }
+
+    pub fn active_sessions(&self) -> usize {
+        self.buffers.len()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Test double — identity backend, same length in/out. A real
+    /// backend (StreamSpeech or a vendor streaming endpoint) replaces
+    /// this and is free to change sample count between languages.
+    struct IdentityBackend;
+
+    #[async_trait]
+    impl StreamingTranslationBackend for IdentityBackend {
+        async fn translate_chunk(&self, pcm: &[f32], _from: &str, _to: &str) -> Result<Vec<f32>, TranslateError> {
+            Ok(pcm.to_vec())
+        }
+    }
+
+    fn silence(n: usize) -> Vec<f32> { vec![0.0f32; n] }
+
+    #[tokio::test]
+    async fn buffers_until_chunk_threshold() {
+        let cfg = ChunkConfig { chunk_ms: 100 }; // 4800 samples @ 48kHz
+        let t = StreamTranslator::new(IdentityBackend, cfg);
+
+        // Feed half a chunk — should not flush yet.
+        let half = silence(cfg.samples_per_chunk() / 2);
+        let r = t.ingest("p1", "en", "es", &half).await.unwrap();
+        assert!(r.is_none());
+
+        // Feed the rest — should flush now.
+        let rest = silence(cfg.samples_per_chunk() - half.len());
+        let r = t.ingest("p1", "en", "es", &rest).await.unwrap();
+        assert!(r.is_some());
+        let chunk = r.unwrap();
+        assert_eq!(chunk.seq, 1);
+        assert!(!chunk.is_final);
+    }
+
+    #[tokio::test]
+    async fn flush_drains_partial_and_marks_final() {
+        let cfg = ChunkConfig { chunk_ms: 500 };
+        let t = StreamTranslator::new(IdentityBackend, cfg);
+
+        let partial = silence(1000); // well under threshold
+        let r = t.ingest("p1", "en", "ja", &partial).await.unwrap();
+        assert!(r.is_none());
+
+        let flushed = t.flush("p1", "en", "ja").await.unwrap().unwrap();
+        assert!(flushed.is_final);
+        assert_eq!(flushed.pcm.len(), 1000);
+    }
+
+    #[tokio::test]
+    async fn independent_sessions_per_target_lang() {
+        let cfg = ChunkConfig::default();
+        let t = StreamTranslator::new(IdentityBackend, cfg);
+
+        t.ingest("p1", "en", "es", &silence(100)).await.unwrap();
+        t.ingest("p1", "en", "ja", &silence(200)).await.unwrap();
+        assert_eq!(t.active_sessions(), 2);
+
+        t.drop_session("p1", "es");
+        assert_eq!(t.active_sessions(), 1);
+    }
+}
