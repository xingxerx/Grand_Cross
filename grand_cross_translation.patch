+++ b/callout.rs
@@ -0,0 +1,147 @@
+//! Callout system — pre-translated, enum-routed comms.
+//!
+//! No STT/MT/TTS in the loop. A CalloutId is a u16, routed through the
+//! same DashMap relay as everything else, and rendered client-side from
+//! a static per-language lookup table. Latency is router-bound only
+//! (same order as a Move packet), not translation-bound.
+//!
+//! This is the "real-time" tier. `translate.rs` is the near-real-time
+//! tier for freeform chat/voice — use this for anything where a
+//! mistranslation or delay has in-raid consequences.
+
+use serde::{Deserialize, Serialize};
+use std::collections::HashMap;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Serialize, Deserialize)]
+#[repr(u16)]
+pub enum CalloutId {
+    EnemyLeft      = 0x0001,
+    EnemyRight     = 0x0002,
+    EnemyAhead     = 0x0003,
+    EnemyBehind    = 0x0004,
+    NeedHeal       = 0x0005,
+    NeedAmmo       = 0x0006,
+    FallBack       = 0x0007,
+    PushForward    = 0x0008,
+    ObjectiveClear = 0x0009,
+    HoldPosition   = 0x000A,
+    Incoming       = 0x000B,
+    Reviving       = 0x000C,
+    Down           = 0x000D,
+    OnMyWay        = 0x000E,
+    Thanks         = 0x000F,
+    Sorry          = 0x0010,
+}
+
+/// Wire payload for CrpEventType::Callout. Tiny — this is the point.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct CalloutPacket {
+    pub player_id: String,
+    pub callout:   CalloutId,
+}
+
+impl CalloutPacket {
+    pub fn encode(&self) -> Vec<u8> {
+        serde_json::to_vec(self).unwrap_or_default()
+    }
+
+    pub fn decode(buf: &[u8]) -> Option<Self> {
+        serde_json::from_slice(buf).ok()
+    }
+}
+
+/// Client-side localization table. One process per player locale,
+/// not per message — this is a static lookup, never a live call.
+pub struct CalloutLocalizer {
+    lang: String,
+    table: HashMap<CalloutId, &'static str>,
+}
+
+impl CalloutLocalizer {
+    pub fn new(lang: &str) -> Self {
+        Self {
+            lang: lang.to_string(),
+            table: Self::table_for(lang),
+        }
+    }
+
+    pub fn render(&self, id: CalloutId) -> &'static str {
+        self.table.get(&id).copied().unwrap_or("[callout]")
+    }
+
+    /// Add/extend language tables here. Keep en as the fallback baseline
+    /// so a missing translation degrades to English, not to a blank string.
+    fn table_for(lang: &str) -> HashMap<CalloutId, &'static str> {
+        use CalloutId::*;
+        let en: &[(CalloutId, &'static str)] = &[
+            (EnemyLeft, "Enemy left!"),
+            (EnemyRight, "Enemy right!"),
+            (EnemyAhead, "Enemy ahead!"),
+            (EnemyBehind, "Enemy behind!"),
+            (NeedHeal, "Need heal!"),
+            (NeedAmmo, "Need ammo!"),
+            (FallBack, "Fall back!"),
+            (PushForward, "Push forward!"),
+            (ObjectiveClear, "Objective clear!"),
+            (HoldPosition, "Hold position!"),
+            (Incoming, "Incoming!"),
+            (Reviving, "Reviving!"),
+            (Down, "Down!"),
+            (OnMyWay, "On my way!"),
+            (Thanks, "Thanks!"),
+            (Sorry, "Sorry!"),
+        ];
+        let es: &[(CalloutId, &'static str)] = &[
+            (EnemyLeft, "¡Enemigo a la izquierda!"),
+            (EnemyRight, "¡Enemigo a la derecha!"),
+            (EnemyAhead, "¡Enemigo al frente!"),
+            (EnemyBehind, "¡Enemigo detrás!"),
+            (NeedHeal, "¡Necesito curación!"),
+            (NeedAmmo, "¡Necesito munición!"),
+            (FallBack, "¡Retirada!"),
+            (PushForward, "¡Avanzar!"),
+            (ObjectiveClear, "¡Objetivo despejado!"),
+            (HoldPosition, "¡Mantener posición!"),
+            (Incoming, "¡Vienen!"),
+            (Reviving, "¡Reviviendo!"),
+            (Down, "¡Caído!"),
+            (OnMyWay, "¡Voy para allá!"),
+            (Thanks, "¡Gracias!"),
+            (Sorry, "¡Perdón!"),
+        ];
+
+        let base: &[(CalloutId, &'static str)] = match lang {
+            "es" => es,
+            _ => en, // fallback baseline
+        };
+        base.iter().copied().collect()
+    }
+
+    pub fn lang(&self) -> &str { &self.lang }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn round_trip_encode_decode() {
+        let pkt = CalloutPacket { player_id: "p1".into(), callout: CalloutId::NeedHeal };
+        let bytes = pkt.encode();
+        let decoded = CalloutPacket::decode(&bytes).unwrap();
+        assert_eq!(decoded.callout, CalloutId::NeedHeal);
+        assert_eq!(decoded.player_id, "p1");
+    }
+
+    #[test]
+    fn localizer_fallback_to_en() {
+        let loc = CalloutLocalizer::new("fr"); // no fr table yet
+        assert_eq!(loc.render(CalloutId::FallBack), "Fall back!");
+    }
+
+    #[test]
+    fn localizer_es() {
+        let loc = CalloutLocalizer::new("es");
+        assert_eq!(loc.render(CalloutId::NeedHeal), "¡Necesito curación!");
+    }
+}
