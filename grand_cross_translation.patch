+++ b/translate.rs
@@ -0,0 +1,124 @@
+//! Freeform chat translation — near-real-time, backend-agnostic.
+//!
+//! This is NOT the low-latency tier. It exists for open chat where
+//! a callout doesn't fit. Sub-second is achievable with a good backend
+//! (streaming ASR + incremental MT), but accuracy trades against speed
+//! — see CallMissed / Forasoft 2026 benchmarks: streaming systems trade
+//! roughly 3-8% accuracy for sub-second latency. Do not route
+//! safety/critical-timing comms through this path; use callout.rs.
+//!
+//! Wire this to a real backend (DeepL, SeamlessM4T, ElevenLabs, etc.)
+//! by implementing TranslationBackend. No backend is bundled here —
+//! that's an API key + vendor decision, not an engineering one.
+
+use async_trait::async_trait;
+use dashmap::DashMap;
+use serde::{Deserialize, Serialize};
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct ChatMessage {
+    pub player_id: String,
+    pub text:      String,
+    pub lang:      String, // BCP-47, e.g. "en", "es", "ja"
+}
+
+#[derive(Debug, thiserror::Error)]
+pub enum TranslateError {
+    #[error("backend error: {0}")]
+    Backend(String),
+    #[error("timeout after {0:?}")]
+    Timeout(Duration),
+}
+
+/// Implement this against whichever vendor you pick. Keep it text-in/
+/// text-out so voice can reuse the same trait once an STT stage feeds it.
+#[async_trait]
+pub trait TranslationBackend: Send + Sync {
+    async fn translate(&self, text: &str, from: &str, to: &str) -> Result<String, TranslateError>;
+}
+
+/// Wraps any backend with a repeat-phrase cache. Players reuse the same
+/// short lines constantly ("gg", "wait", "here") — caching cuts both
+/// latency and per-call cost on repeats without touching accuracy.
+pub struct CachingTranslator<B: TranslationBackend> {
+    backend: B,
+    cache:   Arc<DashMap<(String, String, String), (String, Instant)>>,
+    ttl:     Duration,
+}
+
+impl<B: TranslationBackend> CachingTranslator<B> {
+    pub fn new(backend: B) -> Self {
+        Self {
+            backend,
+            cache: Arc::new(DashMap::new()),
+            ttl:   Duration::from_secs(3600),
+        }
+    }
+
+    pub async fn translate(&self, text: &str, from: &str, to: &str) -> Result<String, TranslateError> {
+        let key = (text.to_string(), from.to_string(), to.to_string());
+
+        if let Some(entry) = self.cache.get(&key) {
+            let (cached, at) = entry.value();
+            if at.elapsed() < self.ttl {
+                return Ok(cached.clone());
+            }
+        }
+
+        let result = self.backend.translate(text, from, to).await?;
+        self.cache.insert(key, (result.clone(), Instant::now()));
+        Ok(result)
+    }
+}
+
+/// Fan a chat message out to N recipient languages. Recipients sharing
+/// the sender's language skip translation entirely (zero latency, zero
+/// cost, zero accuracy risk — always the cheapest path when it applies).
+pub async fn translate_for_recipients<B: TranslationBackend>(
+    translator: &CachingTranslator<B>,
+    msg: &ChatMessage,
+    recipient_langs: &[String],
+) -> Vec<(String, Result<String, TranslateError>)> {
+    let mut out = Vec::with_capacity(recipient_langs.len());
+    for lang in recipient_langs {
+        if lang == &msg.lang {
+            out.push((lang.clone(), Ok(msg.text.clone())));
+            continue;
+        }
+        let r = translator.translate(&msg.text, &msg.lang, lang).await;
+        out.push((lang.clone(), r));
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    struct EchoBackend; // test double — real vendor implements this trait
+
+    #[async_trait]
+    impl TranslationBackend for EchoBackend {
+        async fn translate(&self, text: &str, _from: &str, to: &str) -> Result<String, TranslateError> {
+            Ok(format!("[{to}] {text}"))
+        }
+    }
+
+    #[tokio::test]
+    async fn same_lang_skips_translation() {
+        let t = CachingTranslator::new(EchoBackend);
+        let msg = ChatMessage { player_id: "p1".into(), text: "gg".into(), lang: "en".into() };
+        let out = translate_for_recipients(&t, &msg, &["en".into()]).await;
+        assert_eq!(out[0].1.as_ref().unwrap(), "gg");
+    }
+
+    #[tokio::test]
+    async fn cache_avoids_second_backend_call() {
+        let t = CachingTranslator::new(EchoBackend);
+        let a = t.translate("gg", "en", "es").await.unwrap();
+        let b = t.translate("gg", "en", "es").await.unwrap();
+        assert_eq!(a, b);
+    }
+}
